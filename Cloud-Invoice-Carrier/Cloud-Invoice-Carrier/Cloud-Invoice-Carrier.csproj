<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Cloud_Invoice_Carrier</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cloud-Invoice-Carrier</AssemblyName>
    <ApplicationTitle>Cloud Invoice Carrier</ApplicationTitle>
  </PropertyGroup>

  <!-- 自包含單檔發佈：Visual Studio 發佈後僅輸出一個 exe（設定檔仍可在 exe 旁覆寫） -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="picture\實際背景1.png" />
    <None Remove="picture\實際背景2.png" />
    <None Remove="picture\實際背景3.png" />
    <None Remove="picture\實際背景4.png" />
    <None Remove="picture\001.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="picture\001.jpg" Condition="Exists('picture\001.jpg')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\picture\001.jpg" Link="picture\001.jpg" Condition="!Exists('picture\001.jpg') And Exists('..\picture\001.jpg')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="picture\實際背景1.png" Condition="Exists('picture\實際背景1.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\picture\實際背景1.png" Link="picture\實際背景1.png" Condition="!Exists('picture\實際背景1.png') And Exists('..\picture\實際背景1.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="picture\實際背景2.png" Condition="Exists('picture\實際背景2.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\picture\實際背景2.png" Link="picture\實際背景2.png" Condition="!Exists('picture\實際背景2.png') And Exists('..\picture\實際背景2.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="picture\實際背景3.png" Condition="Exists('picture\實際背景3.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\picture\實際背景3.png" Link="picture\實際背景3.png" Condition="!Exists('picture\實際背景3.png') And Exists('..\picture\實際背景3.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="picture\實際背景4.png" Condition="Exists('picture\實際背景4.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\picture\實際背景4.png" Link="picture\實際背景4.png" Condition="!Exists('picture\實際背景4.png') And Exists('..\picture\實際背景4.png')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="picture\載具背景1.png" Condition="Exists('picture\載具背景1.png')" />
    <EmbeddedResource Include="..\picture\載具背景1.png" Link="picture\載具背景1.png" Condition="!Exists('picture\載具背景1.png') And Exists('..\picture\載具背景1.png')" />
    <EmbeddedResource Include="picture\載具背景2.png" Condition="Exists('picture\載具背景2.png')" />
    <EmbeddedResource Include="..\picture\載具背景2.png" Link="picture\載具背景2.png" Condition="!Exists('picture\載具背景2.png') And Exists('..\picture\載具背景2.png')" />
    <EmbeddedResource Include="picture\載具背景3.png" Condition="Exists('picture\載具背景3.png')" />
    <EmbeddedResource Include="..\picture\載具背景3.png" Link="picture\載具背景3.png" Condition="!Exists('picture\載具背景3.png') And Exists('..\picture\載具背景3.png')" />
    <EmbeddedResource Include="picture\載具背景4.png" Condition="Exists('picture\載具背景4.png')" />
    <EmbeddedResource Include="..\picture\載具背景4.png" Link="picture\載具背景4.png" Condition="!Exists('picture\載具背景4.png') And Exists('..\picture\載具背景4.png')" />
  </ItemGroup>

  <ItemGroup>
    <None Update=".env.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Update="env.package">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
      <None Update="carrier-layout.example.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </None>
      <None Update="carrier-layout.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </None>
    <None Update="姓名貼鍵盤.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="zhuyin-dict.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="jszhuyin\database.data">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="載具生成器2.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="picture\titan01.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="picture\titan02.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="jszhuyin\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="lib\simple-keyboard\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="lib\jsbarcode\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="picture\head\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="picture\back\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="picture\AdPage\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="picture\InputPage\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="picture\PrintPage\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="picture\ChoosePage\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="picture\preview\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\picture\head\**\*" Link="picture\head\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\picture\head')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\picture\back\**\*" Link="picture\back\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\picture\back')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\picture\AdPage\**\*" Link="picture\AdPage\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\picture\AdPage')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\picture\InputPage\**\*" Link="picture\InputPage\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\picture\InputPage')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\picture\PrintPage\**\*" Link="picture\PrintPage\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\picture\PrintPage')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\picture\ChoosePage\**\*" Link="picture\ChoosePage\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\picture\ChoosePage')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\picture\preview\**\*" Link="picture\preview\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\picture\preview')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 靜態資源打包進單一 exe；.env / carrier-layout 維持在 exe 旁可編輯 -->
  <ItemGroup>
    <Content Update="@(Content)">
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
    <None Update="姓名貼鍵盤.html;載具生成器2.html;zhuyin-dict.json;jszhuyin\database.data;picture\titan01.jpg;picture\titan02.jpg">
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </None>
  </ItemGroup>  

  <!-- 建置／發佈時將 env.package（或專案根目錄 .env）複製為 exe 旁的 .env -->
  <Target Name="CopyAppEnvToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_AppEnvSource Condition="Exists('$(MSBuildProjectDirectory)\.env')">$(MSBuildProjectDirectory)\.env</_AppEnvSource>
      <_AppEnvSource Condition="'$(_AppEnvSource)' == '' And Exists('$(MSBuildProjectDirectory)\env.package')">$(MSBuildProjectDirectory)\env.package</_AppEnvSource>
      <_AppEnvSource Condition="'$(_AppEnvSource)' == '' And Exists('$(MSBuildProjectDirectory)\.env.example')">$(MSBuildProjectDirectory)\.env.example</_AppEnvSource>
    </PropertyGroup>
    <Copy SourceFiles="$(_AppEnvSource)"
          DestinationFiles="$(OutputPath).env"
          Condition="Exists('$(_AppEnvSource)')" />
  </Target>

  <Target Name="CopyAppEnvToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_AppEnvSource Condition="Exists('$(MSBuildProjectDirectory)\.env')">$(MSBuildProjectDirectory)\.env</_AppEnvSource>
      <_AppEnvSource Condition="'$(_AppEnvSource)' == '' And Exists('$(MSBuildProjectDirectory)\env.package')">$(MSBuildProjectDirectory)\env.package</_AppEnvSource>
      <_AppEnvSource Condition="'$(_AppEnvSource)' == '' And Exists('$(MSBuildProjectDirectory)\.env.example')">$(MSBuildProjectDirectory)\.env.example</_AppEnvSource>
    </PropertyGroup>
    <Copy SourceFiles="$(_AppEnvSource)"
          DestinationFiles="$(PublishDir).env"
          Condition="Exists('$(_AppEnvSource)')" />
  </Target>
 
</Project>    