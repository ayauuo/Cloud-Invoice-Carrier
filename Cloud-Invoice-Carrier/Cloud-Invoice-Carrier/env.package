# 建置／發佈時會複製為 exe 同目錄的「.env」。可直接編輯本檔；若專案根目錄另有 .env 則優先使用。
#
# carrier：載具條碼（載具生成器2.html）
# name_label：姓名貼（中文軟鍵盤 + TSC TTP-345）
APP_MODE=carrier

# Kiosk 全螢幕鎖定（true=現場機台、false=開發／可關閉視窗）
KIOSK_ENABLED=true

# carrier：是否允許選擇載具背面樣式（true=可分別選、false=隱藏背面選擇）
CARRIER_ALLOW_BACK_TEMPLATE_SELECTION=false
# carrier：版型選擇模式（selection=使用者點選、random=隨機抽取並隱藏選版區）
CARRIER_TEMPLATE_MODE=selection
# carrier：是否顯示「列印內容／列印方式／雙面翻面補償」選項
CARRIER_SHOW_DUPLEX_FLIP_COMPENSATION=true
# carrier：是否列印載具條碼（true=印/false=不印）
CARRIER_PRINT_BARCODE=false
# carrier：是否在背面也印載具條碼
CARRIER_PRINT_BARCODE_ON_BACK=false
# carrier：是否啟用 RS232 紙鈔機（false 時待機頁可點擊直接進入）
BILL_ACCEPTOR_ENABLED=true
# carrier：紙鈔機串口（固定使用此 COM，程式不會自動改連其他埠）
BILL_ACCEPTOR_PORT=COM3
# carrier：資料庫報表專案名稱
CARRIER_PROJECT_NAME=載具列印

# carrier：列印時是否將合成圖存到本機
SAVE_PRINT_IMAGE=false
PRINT_SAVE_FOLDER=C:\test

# Windows「印表機與掃描器」顯示的印表機名稱（需與驅動完全一致）
TSC_WINDOWS_PRINTER_NAME=TSC TTP-345

TSC_DPI=300
LABEL_WIDTH_MM=110
LABEL_HEIGHT_MM=135
LABEL_GAP_MM=0
TSC_PAPER_SENSOR_MODE=blackmark
TSC_BLACK_MARK_MM=5
TSC_BLACK_MARK_POST_FEED_STEPS=404

# 姓名貼輸入框預設文字（\n 代表換行；多行時每列印一行）
NAME_LABEL_DEFAULT_TEXT=吊飾兌換券\n進擊的巨人《載具吊飾卡》\n台北漫博7/23-7/27展期間\n憑此張兌換券向木棉花機台區\n工作人員領取吊飾及保護套\n此券請交由工作人員回收

NAME_LABEL_COLUMNS=3
NAME_LABEL_ROWS=6
NAME_LABEL_CELL_GAP_MM=1
NAME_LABEL_COLUMN_GAP_MM=0.4
NAME_LABEL_ROW_GAP_MM=3
NAME_LABEL_GRID_HEIGHT_MM=94.8
NAME_LABEL_LAYOUT_SCALE=0.4
NAME_LABEL_CHAR_SPACING_PX=-30
NAME_LABEL_FIRST_COLUMN_OFFSET_X_PX=30
NAME_LABEL_COLUMN_OFFSETS_X_PX=50,20,-10

NAME_LABEL_PRINT_MODE=bitmap
NAME_LABEL_TSPL_FONT=TST24.BF2
NAME_LABEL_BITMAP_FONT_FAMILY=Microsoft JhengHei
NAME_LABEL_ROTATE_180=true
TSC_SPEED=2
TSC_DENSITY=8
TSC_CODEPAGE=950
TSC_CHARSET=BIG5
BITMAP_THRESHOLD=180
BITMAP_BOLD_PX=0
DEBUG_SAVE_BITMAP=true
DEBUG_BITMAP_PATH=C:\test\test_label.png
TSC_CUT_AFTER_PRINT=true
